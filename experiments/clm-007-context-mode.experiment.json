  "experiment_id": "clm-007-context-mode",
  "title": "CLM-007: bounded context versus legacy context on the smoke suite",
  "description": "Compares the bounded context mode against the legacy context mode with otherwise identical settings. Preregistered on the frozen rae-smoke-v1 suite.",
  "hypothesis": {
    "claim_id": "CLM-007",
    "statement": "Increasing context length without increasing task-relevant information can reduce effective signal density and impair long-context performance.",
    "treatment_arm": "bounded-context",
    "control_arm": "legacy-context",
    "expected": "treatment-greater",
    "falsifier": "The longer legacy context does not lower the gate pass rate by more than the run-to-run spread."
  },
  "suite": {
    "path": "suites/rae-smoke-v1/suite.json",
    "digest": "e289144daeaeba8bae5f68ce6fda29393e6f7b11ff9bfe6e1ebe80d8034514dc"
  },
  "arms": [
    {
      "arm_id": "legacy-context",
      "label": "Legacy context mode",
      "run": {
        "context_mode": "legacy",
        "provider": "codex"
      }
    },
    {
      "arm_id": "bounded-context",
      "label": "Bounded context mode",
      "run": {
        "context_mode": "bounded",
        "provider": "codex"
      }
    }
  ],
  "design": {
    "repetitions": 3,
    "seed": 7,
