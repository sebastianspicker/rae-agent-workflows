{
  "name": "@rae/repository-tools",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:benchmarks": "tsc -p tsconfig.benchmarks.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.benchmarks.json --noEmit",
    "check:architecture": "node dist/check-architecture.js",
    "check:source": "node dist/check-source.js",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@rae/fs-bridge": "file:../packages/fs-bridge",
    "saxes": "6.0.0"
  }
}
