{
  "name": "@rae/experimental-platform",
  "version": "0.1.0-experimental",
  "private": true,
  "type": "module",
  "description": "Experimental hosted control-plane and worker boundary for RAE.",
  "bin": {
    "rae-platform": "dist/bin/rae-platform.js",
    "rae-platform-worker": "dist/bin/rae-platform-worker.js"
  },
  "scripts": {
    "control": "node dist/bin/rae-platform.js",
    "worker": "node dist/bin/rae-platform-worker.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test dist/test/*.test.js",
    "test:integration": "npm run build:test && node --test dist/test/postgres-store.integration.test.js"
  },
  "dependencies": {
    "@rae/contracts": "file:../../packages/contracts",
    "@rae/engine": "file:../../packages/engine",
    "@aws-sdk/client-s3": "3.1102.0",
    "@aws-sdk/s3-request-presigner": "3.1102.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex": "0.146.0",
    "jose": "6.2.8",
    "pg": "8.22.0",
    "smol-toml": "1.7.1",
    "zod": "4.4.3",
    "@rae/fs-bridge": "file:../../packages/fs-bridge"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
