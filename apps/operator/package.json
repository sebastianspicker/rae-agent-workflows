{
  "name": "@rae/operator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node dist/scripts/copy-assets.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:demo": "npm run build && node dist/scripts/build-demo.js",
    "start": "npm run build && node dist/server.js",
    "test": "node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@rae/engine": "*"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
