{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rae.local/contracts/experiments/trial-record-v1.schema.json",
  "title": "RAE experiment trial record v1",
  "description": "The immutable outcome of one (arm, task, repetition) trial. Written once by the experiment runner; failure-layer labels may be appended afterwards.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "experiment_digest", "suite_digest", "trial_id", "arm_id", "task_id", "repetition", "sequence", "status", "run", "outcome", "measurements", "failure_layer_labels", "evidence_refs"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "experiment_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "experiment_digest": { "$ref": "#/$defs/digest" },
    "suite_digest": { "$ref": "#/$defs/digest" },
    "trial_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,191}$" },
    "arm_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "repetition": { "type": "integer", "minimum": 1, "maximum": 64 },
    "sequence": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["completed", "launch-failed", "collect-failed", "skipped"] },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "wall_clock_ms"],
      "properties": {
        "run_id": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 128 },
        "workspace_root": { "type": "string", "maxLength": 4096 },
        "report_path": { "type": "string", "maxLength": 4096 },
        "workflow_digest": { "$ref": "#/$defs/digest" },
        "policy_digest": { "$ref": "#/$defs/digest" },
        "execution_profile_digest": { "$ref": "#/$defs/digest" },
        "context_mode": { "enum": ["legacy", "bounded"] },
        "provider": { "type": "string", "maxLength": 64 },
        "model": { "type": ["string", "null"], "maxLength": 160 },
        "reasoning_effort": { "type": ["string", "null"], "maxLength": 32 },
        "runtime_identity": { "type": ["object", "null"] },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "finished_at": { "$ref": "#/$defs/timestamp" },
        "wall_clock_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "reached_ship_state", "acceptance_pass", "acceptance", "seeded_defects_shipped", "seeded_defects"],
      "properties": {
        "pass": { "type": ["boolean", "null"], "description": "reached_ship_state and acceptance_pass; null when acceptance could not be evaluated." },
        "reached_ship_state": { "type": "boolean" },
        "acceptance_pass": { "type": ["boolean", "null"] },
        "acceptance": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/checkResult" } },
        "seeded_defects_shipped": { "type": ["integer", "null"], "minimum": 0 },
        "seeded_defects": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/checkResult" } }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_attempts", "nodes", "repair_rounds", "changed_paths", "tokens", "estimated_cost"],
      "properties": {
        "provider_attempts": { "type": "integer", "minimum": 0 },
        "nodes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passed", "failed", "blocked", "stopped", "skipped"],
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "blocked": { "type": "integer", "minimum": 0 },
            "stopped": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 }
          }
        },
        "repair_rounds": { "type": "integer", "minimum": 0 },
        "changed_paths": { "type": "integer", "minimum": 0 },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measurement_status", "attempts_measured"],
          "properties": {
            "measurement_status": { "enum": ["complete", "partial", "unavailable"] },
            "attempts_measured": { "type": "integer", "minimum": 0 },
            "input_tokens": { "type": "integer", "minimum": 0 },
            "cached_input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "reasoning_output_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        "estimated_cost": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["currency", "value", "basis"],
          "properties": {
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "value": { "type": "number", "minimum": 0 },
            "basis": { "enum": ["arm-pricing"] }
          }
        }
      }
    },
    "failure_layer_labels": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rater", "layer", "labeled_at"],
        "properties": {
          "rater": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "layer": { "enum": ["representation", "inference", "coordination", "governance", "none"] },
          "note": { "type": "string", "maxLength": 4000 },
          "labeled_at": { "$ref": "#/$defs/timestamp" }
        }
      }
    },
    "evidence_refs": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
    "error": { "type": "string", "maxLength": 8000 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "kind", "passed"],
      "properties": {
        "check_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "enum": ["command", "path-exists", "path-absent", "file-contains", "file-lacks"] },
        "passed": { "type": "boolean" },
        "exit_code": { "type": ["integer", "null"] },
        "detail": { "type": "string", "maxLength": 4000 }
      }
    }
  }
}
