{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rae.local/contracts/experiments/task-suite-v1.schema.json",
  "title": "RAE frozen task suite v1",
  "description": "A frozen, model-agnostic set of repository tasks with machine-checkable acceptance. Suites are immutable once digested; change tasks by publishing a new revision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "revision", "title", "provenance", "repositories", "tasks"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "suite_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 8000 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "license", "contamination_note"],
      "properties": {
        "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "authors": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "license": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sources": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "contamination_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "description": "How the tasks relate to public corpora and model training cutoffs. 'unknown' is an acceptable, honest value."
        }
      }
    },
    "repositories": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/repository" }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).*$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "repository": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "directory" },
            "path": { "$ref": "#/$defs/relativePath" },
            "description": { "type": "string", "maxLength": 2000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "commit"],
          "properties": {
            "kind": { "const": "git" },
            "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "description": { "type": "string", "maxLength": 2000 }
          }
        }
      ]
    },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["check_id", "kind", "command"],
          "properties": {
            "check_id": { "$ref": "#/$defs/identifier" },
            "kind": { "const": "command" },
            "command": { "$ref": "#/$defs/argv" },
            "expected_exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
            "description": { "type": "string", "maxLength": 2000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["check_id", "kind", "path"],
          "properties": {
            "check_id": { "$ref": "#/$defs/identifier" },
            "kind": { "enum": ["path-exists", "path-absent"] },
            "path": { "$ref": "#/$defs/relativePath" },
            "description": { "type": "string", "maxLength": 2000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["check_id", "kind", "path", "pattern"],
          "properties": {
            "check_id": { "$ref": "#/$defs/identifier" },
            "kind": { "enum": ["file-contains", "file-lacks"] },
            "path": { "$ref": "#/$defs/relativePath" },
            "pattern": { "type": "string", "minLength": 1, "maxLength": 1024, "description": "A JavaScript regular expression source without flags." },
            "description": { "type": "string", "maxLength": 2000 }
          }
        }
      ]
    },
    "seededDefect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defect_id", "description", "detector"],
      "properties": {
        "defect_id": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "detector": {
          "$ref": "#/$defs/check",
          "description": "A check that passes when the defect is still present in the final tree."
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "title", "prompt", "repository", "acceptance"],
      "properties": {
        "task_id": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "repository": { "$ref": "#/$defs/identifier" },
        "tags": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "difficulty": { "enum": ["trivial", "easy", "medium", "hard"] },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checks"],
          "properties": {
            "checks": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/check" } },
            "require_all": { "type": "boolean" }
          }
        },
        "seeded_defects": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/seededDefect" } },
        "reference_note": { "type": "string", "maxLength": 4000 }
      }
    }
  }
}
