{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rae.local/contracts/experiments/evidence-manifest-v1.schema.json",
  "title": "RAE retained experiment evidence manifest v1",
  "description": "Private exact-byte run evidence, evaluated repository patch and untracked files. SHA-256 identities refer to stored bytes. Publication requires independent review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "experiment_digest",
    "suite_digest",
    "input_digest",
    "trial_id",
    "arm_id",
    "task_id",
    "repetition",
    "sequence",
    "run_id",
    "created_at",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "experiment_id": {
      "type": "string"
    },
    "experiment_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "suite_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trial_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,191}$"
    },
    "arm_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "repetition": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "executable"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "executable": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
