{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rae.local/contracts/graph/memory-decision.schema.json",
  "title": "RAE graph memory decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "candidate_id", "decision", "actor", "rationale", "source_ref", "source_digest", "recorded_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "decision_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["promoted", "rejected", "superseded", "invalidated"] },
    "actor": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "source_ref": { "type": "string", "minLength": 1 },
    "source_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recorded_at": { "type": "string", "format": "date-time" }
  }
}
