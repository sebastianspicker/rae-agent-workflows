{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator control state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "stop_requested", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "waiting",
        "stop-requested",
        "stopped",
        "interrupted",
        "blocked",
        "completed"
      ]
    },
    "stop_requested": { "type": "boolean" },
    "stop_requested_at": { "type": "string", "format": "date-time" },
    "interrupted_at": { "type": "string", "format": "date-time" },
    "waiting_checkpoint_id": { "type": ["string", "null"] },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
