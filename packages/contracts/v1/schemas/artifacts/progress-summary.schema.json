{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Progress summary artifact",
  "description": "Operator-facing run status summary derived from pipeline state, gates, and trace summaries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "current_phase",
    "workspace_mode",
    "phase_status",
    "gate_totals",
    "blockers",
    "next_action",
    "updated_at"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "current_phase": { "type": "string", "minLength": 1 },
    "workspace_mode": { "type": "string", "minLength": 1 },
    "phase_status": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "status", "gate_status"],
        "properties": {
          "phase": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["pending", "active", "completed", "blocked"]
          },
          "gate_status": {
            "type": "string",
            "enum": ["pass", "warn", "fail", "pending"]
          }
        }
      }
    },
    "gate_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "warn", "fail", "pending"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "activity_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["activity_id", "count"],
        "properties": {
          "activity_id": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 0 },
          "tier": { "type": "string" },
          "model_hint": { "type": "string" },
          "runtime_name": { "type": "string" },
          "runtime_version": { "type": "string" }
        }
      }
    },
    "cost_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_cost_usd", "total_tokens_in", "total_tokens_out"],
      "properties": {
        "total_cost_usd": { "type": "number", "minimum": 0 },
        "total_tokens_in": { "type": "integer", "minimum": 0 },
        "total_tokens_out": { "type": "integer", "minimum": 0 }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "primary_repo_root": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "worktree_path": { "type": "string", "minLength": 1 },
        "cleanup_command": { "type": "string", "minLength": 1 }
      }
    },
    "reaction_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "status"],
        "properties": {
          "event": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "source": { "type": "string" },
          "note": { "type": "string" },
          "recorded_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "next_action": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
