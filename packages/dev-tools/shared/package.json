{
  "name": "@rae/dev-tools-shared",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "biome lint --config-path ../../../biome.json --vcs-enabled=false src",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --config-path ../../../biome.json --vcs-enabled=false src",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@biomejs/biome": "2.5.15",
    "typescript": "5.9.3"
  }
}
